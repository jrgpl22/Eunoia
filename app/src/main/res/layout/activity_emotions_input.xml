<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dateCF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EmotionsInput">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/here_layout"
        tools:layout_editor_absoluteX="142dp"
        tools:layout_editor_absoluteY="0dp">

        <TextView
            android:id="@+id/textView10"
            android:layout_width="64dp"
            android:layout_height="23dp"
            android:layout_marginStart="60dp"
            android:layout_marginEnd="44dp"
            android:fontFamily="@font/baloo"
            android:text="SAD"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toStartOf="@+id/textView8"
            app:layout_constraintStart_toEndOf="@+id/textView9"
            app:layout_constraintTop_toBottomOf="@+id/sad" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="64dp"
            android:layout_height="23dp"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="156dp"
            android:fontFamily="@font/baloo"
            android:text="FEAR"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fear"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="88dp"
            android:layout_height="28dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="158dp"
            android:fontFamily="@font/baloo"
            android:text="ANGER"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/angry"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="64dp"
            android:layout_height="23dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/baloo"
            android:text="SHY"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toTopOf="@+id/sad"
            app:layout_constraintEnd_toStartOf="@+id/textView2"
            app:layout_constraintStart_toEndOf="@+id/textView3"
            app:layout_constraintTop_toBottomOf="@+id/calm" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="64dp"
            android:layout_height="23dp"
            android:layout_marginStart="70dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/baloo"
            android:text="JOY"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toTopOf="@+id/fear"
            app:layout_constraintEnd_toStartOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/happy"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="156dp"
            android:fontFamily="@font/baloo"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:singleLine="false"
            android:text="How are you feeling today?"

            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.533"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dateinput"
            android:layout_width="202dp"
            android:layout_height="34dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/baloo"
            android:text="date"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <ImageView
            android:id="@+id/calm"
            android:layout_width="91dp"
            android:layout_height="91dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/neutral"
            app:layout_constraintStart_toEndOf="@+id/happy"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.517"
            app:srcCompat="@drawable/embarressed" />

        <ImageView
            android:id="@+id/happy"
            android:layout_width="91dp"
            android:layout_height="91dp"
            android:layout_marginStart="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/calm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.517"
            app:srcCompat="@drawable/joyful" />

        <ImageView
            android:id="@+id/sad"
            android:layout_width="91dp"
            android:layout_height="91dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/angry"
            app:layout_constraintStart_toEndOf="@+id/fear"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.72"
            app:srcCompat="@drawable/sadness" />

        <ImageView
            android:id="@+id/angry"
            android:layout_width="91dp"
            android:layout_height="91dp"
            android:layout_marginEnd="33dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.965"
            app:layout_constraintStart_toEndOf="@+id/sad"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.72"
            app:srcCompat="@drawable/anger" />

        <ImageView
            android:id="@+id/deleteButton"
            android:layout_width="62dp"
            android:layout_height="40dp"
            android:layout_marginBottom="96dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/baseline_delete_24" />


        <ImageView
            android:id="@+id/back"
            android:layout_width="31dp"
            android:layout_height="43dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.042"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/back" />

        <ImageView
            android:id="@+id/fear"
            android:layout_width="91dp"
            android:layout_height="91dp"
            android:layout_marginStart="35dp"
            android:layout_marginTop="39dp"
            android:layout_marginBottom="139dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/sad"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/happy"
            app:layout_constraintVertical_bias="0.0"
            app:srcCompat="@drawable/fear" />

        <ImageView
            android:id="@+id/neutral"
            android:layout_width="91dp"
            android:layout_height="91dp"
            android:layout_marginEnd="33dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/calm"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.517"

            app:srcCompat="@drawable/bored" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="84dp"
            android:layout_height="24dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="60dp"
            android:layout_marginBottom="15dp"
            android:fontFamily="@font/baloo"
            android:text="BORED"
            android:textAlignment="center"
            android:textColor="#663E20"
            android:textSize="20sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toTopOf="@+id/angry"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView4"
            app:layout_constraintTop_toBottomOf="@+id/neutral"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>