<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settings_layout"
    tools:context=".SettingsFragment">

    <Button
        android:id="@+id/helpButton"
        android:layout_width="308dp"
        android:layout_height="50dp"
        android:layout_marginBottom="224dp"
        android:background="@drawable/ripple_effect"
        android:contentDescription="g"
        android:elevation="0dp"
        android:foreground="@drawable/button_shadow_effect"
        android:padding="5dp"
        android:stateListAnimator="@null"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/accountButton"
        android:layout_width="306dp"
        android:layout_height="50dp"
        android:layout_marginBottom="167dp"
        android:background="@drawable/ripple_effect"
        android:contentDescription="y"
        android:elevation="0dp"
        android:foreground="@drawable/button_shadow_effect"
        android:padding="5dp"
        android:stateListAnimator="@null"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/changePasswordBtn"
        android:layout_width="308dp"
        android:layout_height="49dp"
        android:layout_marginBottom="328dp"
        android:background="@drawable/ripple_effect"
        android:contentDescription="Delete"
        android:elevation="0dp"
        android:foreground="@drawable/button_shadow_effect"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/notifation"
        android:layout_width="308dp"
        android:layout_height="59dp"
        android:layout_marginBottom="380dp"
        android:background="@drawable/ripple_effect"
        android:contentDescription="notif"
        android:elevation="0dp"
        android:foreground="@drawable/button_shadow_effect"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.543"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/delete_data"
        android:layout_width="308dp"
        android:layout_height="49dp"
        android:layout_marginBottom="272dp"
        android:background="@drawable/ripple_effect"
        android:contentDescription="Delete"
        android:elevation="0dp"
        android:foreground="@drawable/button_shadow_effect"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/ACC_NAME"
        android:layout_width="109dp"
        android:layout_height="18dp"
        android:fontFamily="@font/baloo_da"
        android:text="TextView"
        android:textAlignment="center"
        android:textColor="#FAEEE5"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/notifation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.731"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.572" />

    <TextView
        android:id="@+id/editusername"
        android:layout_width="101dp"
        android:layout_height="20dp"
        android:layout_marginStart="210dp"
        android:layout_marginTop="208dp"
        android:layout_marginEnd="53dp"
        android:layout_marginBottom="32dp"
        android:foreground="?attr/selectableItemBackground"
        android:text="Edit username"
        android:textAlignment="center"
        android:textColor="#FAEEE5"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.595"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/logout"
        android:layout_width="307dp"
        android:layout_height="54dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/ripple_effect"
        android:contentDescription="Logout button"
        android:elevation="0dp"
        android:foreground="@drawable/button_shadow_effect"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/editbtn"
        android:layout_width="21dp"
        android:layout_height="18dp"
        android:layout_marginStart="56dp"
        android:backgroundTint="#00FFFFFF"
        android:foreground="?attr/selectableItemBackground"
        android:src="@drawable/editbtnpfl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/editusername"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.301" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profileimg"
        android:layout_width="90dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="centerCrop"
        android:src="@drawable/profile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.211"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.208"
        app:shapeAppearanceOverlay="@style/CircleShape" />

</androidx.constraintlayout.widget.ConstraintLayout>