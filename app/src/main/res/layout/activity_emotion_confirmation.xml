    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/dateCF"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".EmotionConfirmation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/layout_input"
            tools:layout_editor_absoluteX="-37dp"
            tools:layout_editor_absoluteY="0dp">


            <ImageView
                android:id="@+id/emotionCF"
                android:layout_width="362dp"
                android:layout_height="149dp"
                android:layout_marginStart="130dp"
                android:layout_marginTop="144dp"
                android:layout_marginEnd="131dp"
                android:layout_marginBottom="28dp"
                android:textAlignment="center"
                app:layout_constraintBottom_toTopOf="@+id/textCF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:srcCompat="@drawable/calm" />

            <TextView
                android:id="@+id/textCF"
                android:layout_width="261dp"
                android:layout_height="51dp"

                android:layout_marginTop="292dp"
                android:fontFamily="@font/baloo_da"
                android:text="TextView"
                android:textAlignment="center"
                android:textColor="#663E20"

                android:textSize="34sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.446"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/save"
                android:layout_width="102dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="Save"
                android:textColor="#FAEEE5"
                android:textStyle="bold"
                app:backgroundTint="#64381a"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/dateCNFRM"
                android:layout_width="234dp"
                android:layout_height="37dp"
                android:layout_marginTop="36dp"
                android:fontFamily="@font/baloo_da"
                android:text="TextView"

                android:textAlignment="center"
                android:textColor="#A05B2A"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/emotionCF"
                app:layout_constraintEnd_toEndOf="@+id/save"
                app:layout_constraintHorizontal_bias="0.546"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0" />

            <ImageView
                android:id="@+id/x"
                android:layout_width="43dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/x"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="334dp"
                android:layout_height="336dp"
                android:fadeScrollbars="false"
                android:fillViewport="true"
                android:nestedScrollingEnabled="true"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.493"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.931">

                <EditText
                    android:id="@+id/notesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fadeScrollbars="false"
                    android:gravity="top|start"
                    android:hint="Add your notes here..."
                    android:fontFamily="@font/baloo_da"
                    android:inputType="textMultiLine"
                    android:minHeight="200dp"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:textColor="#663E20"
                    android:textCursorDrawable="@null" />

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>