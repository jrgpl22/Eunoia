<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/change"
    android:padding="20dp">

    <!-- Old Password -->

    <!-- New Password -->

    <!-- Confirm Password -->

    <EditText
        android:id="@+id/oldPassword"
        android:layout_width="257dp"
        android:layout_height="36dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="56dp"
        android:backgroundTint="#00FAEEE5"
        android:ems="10"
        android:hint="Enter Old Password"
        android:inputType="textPassword"
        android:textColor="#000000"
        android:textColorHint="#00FAEEE5"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/newPassword"
        app:layout_constraintEnd_toStartOf="@+id/toggleOldPass"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/toggleOldPass"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-30dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:contentDescription="Toggle Old Password Visibility"
        android:focusable="true"
        android:src="@drawable/ic_eye_closed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/oldPassword"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.58" />

    <EditText
        android:id="@+id/newPassword"
        android:layout_width="259dp"
        android:layout_height="36dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="19dp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="#00FAEEE5"
        android:ems="10"
        android:hint="Enter New Password"
        android:inputType="textPassword"
        android:textColor="#000000"
        android:textColorHint="#00FAEEE5"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/newPassword2"
        app:layout_constraintEnd_toStartOf="@+id/toggleNewPass"
        app:layout_constraintHorizontal_bias="0.682"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Change Password Button -->

    <ImageView
        android:id="@+id/toggleNewPass"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-50dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:contentDescription="Toggle New Password Visibility"
        android:focusable="true"
        android:src="@drawable/ic_eye_closed"
        app:layout_constraintBottom_toTopOf="@+id/toggleConfirmPass"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/newPassword"
        app:layout_constraintTop_toBottomOf="@+id/toggleOldPass"
        app:layout_constraintVertical_bias="0.526" />

    <EditText
        android:id="@+id/newPassword2"
        android:layout_width="259dp"
        android:layout_height="36dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="22dp"
        android:backgroundTint="#00FAEEE5"
        android:ems="10"
        android:hint="Confirm New Password"
        android:inputType="textPassword"
        android:textColor="#000000"
        android:textColorHint="#00FAEEE5"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/changePasswordButton"
        app:layout_constraintEnd_toStartOf="@+id/toggleConfirmPass"
        app:layout_constraintHorizontal_bias="0.636"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/toggleConfirmPass"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="-30dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:clickable="true"
        android:contentDescription="Toggle Confirm Password Visibility"
        android:focusable="true"
        android:src="@drawable/ic_eye_closed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/newPassword2"
        app:layout_constraintTop_toBottomOf="@+id/toggleOldPass"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/changePasswordButton"
        android:layout_width="216dp"
        android:layout_height="57dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="20dp"
        android:padding="12dp"
        android:text="Change Password"
        android:textColor="@android:color/black"
        app:backgroundTint="#faeee5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
