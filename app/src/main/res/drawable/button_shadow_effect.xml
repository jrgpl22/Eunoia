<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/button_shadow_effect.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When button is pressed -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1A000000" /> <!-- Shadow color -->
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- When button is focused (hovered) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1A000000" /> <!-- Shadow color -->
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="0.5dp" android:right="0.5dp" android:top="0.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="#26000000" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>